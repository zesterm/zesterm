{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zesterm",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // No compatibility_flags, and that is a decision rather than an omission. In
  // particular no `nodejs_als`: that is what `@sigx/actors/host` needs to run,
  // and ADR-005 says session actors run on the user's machine and never at the
  // edge. If this list ever grows an ALS flag, something crept in that should
  // not have.

  "workers_dev": true,
  // Preview URLs stay on, but know what they are: each deployment also gets its
  // own hostname, and those are *different origins*. Every cookie here is
  // `__Host-` prefixed and therefore pinned to one host, so signing in simply
  // does not work on a preview URL -- the Set-Cookie is issued and the browser
  // drops it. Useful for eyeballing a build, not for testing auth. Set
  // `preview_urls: false` to turn them off.
  "observability": { "enabled": true },

  "assets": {
    // The one thing cloud/ and clients/web share is this directory. A path,
    // deliberately, and not a package dependency -- see cloud/README.md.
    "directory": "../../../clients/web/packages/app/dist",
    "binding": "ASSETS",
    // The app owns /hosts, /settings, /h/:id/... client-side. An unknown path
    // must return index.html so a deep link or a refresh works.
    "not_found_handling": "single-page-application",
    // ...but that fallback would otherwise swallow the API: a fetch to a
    // mistyped /api/ path would get 200 and a page of HTML. These prefixes run
    // the Worker before the asset layer ever sees the request.
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  "vars": {
    // The `workers.dev` subdomain is per *account* and this one is shared with
    // sigx, so `zesterm.workers.dev` was never available without moving every
    // sigx Worker; the Worker's own name carries the identity instead.
    //
    // Changing this later is not free: every `__Host-` cookie is host-scoped,
    // so moving origin signs everybody out. Worth settling on a custom domain
    // before there are people to sign out.
    "APP_ORIGIN": "https://zesterm.sigx.workers.dev",

    // Public, and deliberately committed: the client id identifies the OAuth
    // app to GitHub and appears in every authorize URL a browser follows. The
    // *secret* is `wrangler secret put GITHUB_CLIENT_SECRET` and never lands
    // in this file.
    //
    // Owned by the `zesterm` org rather than a personal account, so the
    // consent screen names the project and the credentials outlive any one
    // person's account.
    "GITHUB_CLIENT_ID": "Ov23liTt8aOk9TURcT1h",

    // The relay Worker's origin, handed to the app by `/api/bootstrap` rather
    // than baked into the bundle -- one `vite build` serves both the sidecar
    // and the edge, so a `VITE_*` variable would mean the bundle you tested is
    // not the bundle you shipped.
    //
    // A separate Worker and therefore a separate origin, which is deliberate:
    // ADR-009 splits them because deploying a Worker evicts every live
    // instance of the Durable Object class it owns. Cross-origin costs the
    // relay nothing, because the ticket is what authorizes it and the session
    // cookie could never have travelled there anyway.
    "RELAY_ORIGIN": "https://zesterm-relay.sigx.workers.dev"
  },

  "d1_databases": [
    {
      // `DB`, not the database's own name: the binding is how *this* Worker
      // refers to it, and a second database later should read as DB vs
      // SOMETHING_ELSE rather than two proper nouns.
      "binding": "DB",
      "database_name": "zesterm",
      "database_id": "bfd5939a-05bf-4c69-9c02-6eedfc43e247",
      // A property of the *database*, not a top-level field -- wrangler rejects
      // it at the top level with "Unexpected fields found", which is only a
      // warning, so the run continues and then fails with "No migrations
      // present" pointing at the default path instead.
      //
      // Resolved relative to this file, so `migrations/` alone would mean
      // `packages/web/migrations/`. They live at `cloud/migrations/` on
      // purpose: they are the database's schema, and the relay Worker will
      // bind the same database.
      "migrations_dir": "../../migrations"
    }
  ]
}
