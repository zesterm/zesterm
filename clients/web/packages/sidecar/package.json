    "@zesterm/control": "workspace:*",
    "@zesterm/proto": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.0",
    "@types/node": "^24.10.1",
