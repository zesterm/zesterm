{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "sigx",
    // JSX is not erasable syntax; vite's oxc transform owns it here, and the
    // rest of the workspace keeps the stricter setting.
    "erasableSyntaxOnly": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "vite.config.ts"]
}
